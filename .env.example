# Copia este archivo a .env y define valores locales. .env nunca se versiona.
# Valores de ejemplo: NO son credenciales reales.

# PostgreSQL del contenedor
POSTGRES_DB=conecsia
POSTGRES_USER=conecsia
POSTGRES_PASSWORD=cambia-esto-postgres
# Puerto del host para PostgreSQL (5433 para no chocar con un PostgreSQL local en 5432)
POSTGRES_HOST_PORT=5433

# JWT de la API (clave de al menos 32 caracteres; duración entre 1 y 120 minutos)
JWT_KEY=cambia-esto-por-una-clave-local-de-32-caracteres-o-mas
JWT_ISSUER=ConecsIA
JWT_AUDIENCE=ConecsIA.Client
JWT_DURATION_MINUTES=60

# Puertos del host
API_HOST_PORT=5080
WEB_HOST_PORT=8080
