# Copia este archivo a .env y define contraseñas locales. .env nunca se versiona.
POSTGRES_ADMIN_PASSWORD=cambia-esto-admin
CONECSIA_MIGRATOR_PASSWORD=cambia-esto-migrador
CONECSIA_APP_PASSWORD=cambia-esto-app

# Puerto del host para PostgreSQL (cámbialo si 5432 está ocupado)
POSTGRES_HOST_PORT=5432

# Contraseña local de los usuarios sintéticos para probar el inicio de sesión real (HU-006, mínimo 12 caracteres)
SEMILLAS_CONTRASENA_USUARIOS=cambia-esto-contrasena-local
